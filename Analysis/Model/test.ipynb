   "source": [
    "import datetime\n",
    "def serial_date_to_string(srl_no,year):\n",
    "    new_date = datetime.datetime(year,1,1,0,0) + datetime.timedelta(srl_no - 1)\n",
    "    return new_date.strftime(\"%Y-%m-%d\")"
   ]
  },
